# Caminho: .env.example
# Referência das variáveis. Para gerar um .env real com segredos aleatórios:
#   ./scripts/gerar-env.sh
# O arquivo .env está no .gitignore: nunca o versione.
GATEWAY_ADDR=:8080
LEDGER_URL=http://localhost:9001
PIX_URL=http://localhost:9002
ANTIFRAUDE_URL=http://localhost:9003
MAX_BODY_BYTES=1048576
UPSTREAM_TIMEOUT=10s
# Mínimo de 32 bytes. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres-hex
JWT_ISSUER=gateway-seguranca
JWT_AUDIENCE=servicos-internos
JWT_TTL=15m
# Lista JSON de clientes; secret_sha256 = sha256 do client_secret (go run ./cmd/hashsecret)
OAUTH_CLIENTS='[{"client_id":"app-exemplo","secret_sha256":"<64-hex>","scopes":["ledger:read"]}]'
