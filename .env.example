# Caminho: .env.example
# Referência das variáveis. Para gerar um .env real com segredos aleatórios:
#   ./scripts/gerar-env.sh
# O arquivo .env está no .gitignore: nunca o versione.
GATEWAY_ADDR=:8080
# Porta publicada no host pelo docker compose (padrão 8080)
GATEWAY_HOST_PORT=8083
LEDGER_URL=http://localhost:9001
PIX_URL=http://localhost:9002
ANTIFRAUDE_URL=http://localhost:9003
MAX_BODY_BYTES=1048576
UPSTREAM_TIMEOUT=10s
# --- Serviços reais (opcional) ---
# Sem estas linhas, o Compose usa os mocks da rede interna. Com elas, o gateway
# encaminha para os projetos reais rodando no host (portas do PC do autor).
#COMPOSE_LEDGER_URL=http://host.docker.internal:8081
#COMPOSE_PIX_URL=http://host.docker.internal:8082
#COMPOSE_ANTIFRAUDE_URL=http://host.docker.internal:8000
# Credencial de SERVIÇO que o gateway apresenta à Ledger (HTTP Basic). Use uma
# conta só para o gateway, nunca a de uma pessoa. Defina as duas ou nenhuma.
#LEDGER_USUARIO=
#LEDGER_SENHA=
# Mínimo de 32 bytes. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres-hex
JWT_ISSUER=gateway-seguranca
JWT_AUDIENCE=servicos-internos
JWT_TTL=15m
# Lista JSON de clientes; secret_sha256 = sha256 do client_secret (go run ./cmd/hashsecret)
OAUTH_CLIENTS='[{"client_id":"app-exemplo","secret_sha256":"<64-hex>","scopes":["ledger:read"]}]'
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=troque-por-uma-senha-aleatoria
REDIS_DB=0
# false = se o Redis cair, responde 503 (fail closed, recomendado)
REDIS_FAIL_OPEN=false
# Token bucket: CAPACITY = rajada máxima; REFILL_PER_SEC = fichas repostas por segundo
RATE_LIMIT_IP_CAPACITY=100
RATE_LIMIT_IP_REFILL_PER_SEC=50
RATE_LIMIT_OAUTH_CAPACITY=10
RATE_LIMIT_OAUTH_REFILL_PER_SEC=0.5
RATE_LIMIT_CLIENT_CAPACITY=20
RATE_LIMIT_CLIENT_REFILL_PER_SEC=10
# Bloqueio de IP: N falhas de segurança dentro da janela -> bloqueio temporário
IPBLOCK_MAX_FAILURES=5
IPBLOCK_WINDOW=10m
IPBLOCK_DURATION=15m
# CIDRs dos proxies/load balancers confiáveis (vazio = nenhum; X-Forwarded-For é ignorado)
TRUSTED_PROXIES=
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria
# Vazio = eventos de segurança só no stdout
DATABASE_URL=postgres://gateway:troque@localhost:5432/seguranca?sslmode=disable
SECLOG_BUFFER=1000
